# ==============================================================================
# MIHORA TECH CANDIDATE PROFILE PORTAL — HEROKU & ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTOMATICALLY PROVIDED BY HEROKU (DO NOT SET MANUALLY IN CONFIG VARS)
# ------------------------------------------------------------------------------
# PORT: Heroku dynamically assigns the port on dyno startup. The application listens on process.env.PORT.
# PORT=

# DATABASE_URL: Heroku Postgres automatically injects this connection string when attached.
# Form: postgres://user:password@ec2-xxx.compute-1.amazonaws.com:5432/dbname
# In local development, leaving this empty activates embedded PostgreSQL (PGlite).
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. REQUIRED PRODUCTION VALUES (CONFIGURE VIA HEROKU CONFIG VARS)
# ------------------------------------------------------------------------------
# Set to 'production' on Heroku: heroku config:set NODE_ENV=production
NODE_ENV=development

# Canonical application URL (e.g. https://careers.mihora.tech)
APP_URL=https://careers.mihora.tech

# Cryptographic Secret for signing JWTs and session cookies (32+ hex characters).
# Generate with: openssl rand -hex 32
# heroku config:set SESSION_SECRET="$(openssl rand -hex 32)"
SESSION_SECRET=

# Secret key required to authorize initial primary administrator creation or recovery.
# Generate with: openssl rand -hex 24
# heroku config:set ADMIN_SETUP_SECRET="$(openssl rand -hex 24)"
ADMIN_SETUP_SECRET=

# ------------------------------------------------------------------------------
# 3. FUTURE EXPANSIONS (NOTE ON DOCUMENT ATTACHMENTS)
# ------------------------------------------------------------------------------
# Candidate resumes/documents are not stored on ephemeral dyno filesystems.
# The portal schema is architected to cleanly support Google Drive or persistent
# cloud storage in a subsequent release without altering candidate profile models.
